{
  "name": "@olympus-ai/compiler",
  "version": "0.0.0",
  "description": "Role compiler: reads the roles directory a person wrote and compiles each role file into the instructions a seat runs under, versioned by hash",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "roles"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@olympus-ai/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
