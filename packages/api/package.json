{
  "name": "@olympus-ai/api",
  "version": "0.0.0",
  "description": "The runtime as a service: the programmatic entry point that carries a run through the line",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "rubrics"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "factory-host": "./dist/host/main.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@olympus-ai/adapters": "workspace:*",
    "@olympus-ai/compiler": "workspace:*",
    "@olympus-ai/core": "workspace:*",
    "@olympus-ai/driver-claude-code": "workspace:*",
    "@olympus-ai/driver-codex": "workspace:*",
    "@olympus-ai/driver-openai-compatible": "workspace:*",
    "@olympus-ai/integrity": "workspace:*",
    "@olympus-ai/readiness": "workspace:*",
    "@olympus-ai/sandbox": "workspace:*",
    "@olympus-ai/triggers": "workspace:*",
    "@olympus-ai/vault": "workspace:*",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@olympus-ai/conformance": "workspace:*"
  },
  "bin": {
    "factory-host": "./src/host/main.ts"
  }
}
