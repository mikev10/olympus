    "@olympus-ai/sandbox": "workspace:*",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "vitest": "^4.1.11"
  }
}
