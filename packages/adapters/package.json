{
  "name": "@olympus-ai/adapters",
  "version": "0.0.0",
  "description": "Stack adapter contracts: test framework, coverage, mutation, behavioral, manifest",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
