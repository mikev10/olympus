# Every variable factory-host reads. Copy to .env, fill in, and export into the
# host's environment (factory-host reads its environment, not this file).
# README.md, "Configure the host", says what each one is for. A missing or
# invalid variable stops the host before it listens, listing every problem.
# Never commit a filled-in copy: .env is gitignored.

# --- Required ---------------------------------------------------------------

# The local token every request must bear, at least 32 characters.
# One way to make one: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FACTORY_API_TOKEN=
FACTORY_LISTEN_PORT=7300
# The policy every run is admitted under; examples/policy.yaml is a start.
FACTORY_POLICY_FILE=
# Roles and rubrics live outside the repository and the trees; examples/ holds both.
FACTORY_ROLES_DIR=
FACTORY_VAULT_STORE=
# The git working copy runs are admitted from. `olympus-ai create --workspace` names this path.
FACTORY_REPOSITORY=
# Must allow symbolic links: on Windows, use WSL2 or enable Developer Mode.
FACTORY_TREES=
ANTHROPIC_API_KEY=
# The GitHub repository a passed run merges into (owner/name), its base branch, and the merge token.
FACTORY_GIT_REPOSITORY=
FACTORY_GIT_BASE_BRANCH=main
FACTORY_GIT_TOKEN=

# --- Optional ---------------------------------------------------------------

# Default 127.0.0.1.
# FACTORY_LISTEN_HOST=
# Required for any run that drafts its spec or tests (--draft-spec, --draft-tests).
# FACTORY_RUBRICS_DIR=
# Who a request bearing the token is, as approvals record it. Default local.
# FACTORY_PRINCIPAL=
# Who sandboxes run as, both or neither. Required on a host with no uids, such as native Windows.
# FACTORY_CONTAINER_UID=
# FACTORY_CONTAINER_GID=
# An OpenAI-compatible endpoint (a JSON file) and its credential.
# FACTORY_ENDPOINT_CONFIG=
# FACTORY_ENDPOINT_KEY=
# The seats the Codex driver fills, comma-separated, and its OpenAI key: both or neither.
# FACTORY_CODEX_SEATS=
# FACTORY_CODEX_KEY=
# Reads check runs, for runs with an observation window.
# FACTORY_CHECKS_TOKEN=
# Each webhook subscription's secret, by the full name the policy gives it.
# FACTORY_WEBHOOK_*=
