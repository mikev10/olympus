# Maintainer-local planning docs. Never staged, committed, pushed, or referenced from any tracked file.
.plan/

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tool-local overrides
.claude/settings.local.json

# Review bundles are TRACKED, deliberately. They used to be ignored here as a
# regenerable cache; the maintainer's call is that the record of what a
# reviewer actually saw belongs in the repository beside the review it
# produced, not on someone's desktop. The SHA-256 in each review-request file
# still pins the bytes, so the tracked copy is corroboration rather than the
# sole evidence. They cannot cause recursion: the review-request skill excludes
# docs/reviews/* from every bundle it builds, so a tracked bundle never appears
# inside a later one.

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Per-plan working directories, never part of the record. Git history is.
.superpowers/
