# Maintainer-local planning docs. Never staged, committed, pushed, or referenced from any tracked file.
.plan/

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tool-local overrides
.claude/settings.local.json

# Review bundles. Regenerable git output, named olympus-<unit>-review.txt by
# the review-request skill. The reviews and triages beside them are tracked
# .md files; the bundles are a cache, and an untracked few hundred kilobytes
# under docs/reviews/ is one `git add docs/reviews/` from being committed.
docs/reviews/*.txt
