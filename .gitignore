# Maintainer-local planning docs. Never staged, committed, pushed, or referenced from any tracked file.
.plan/

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tool-local overrides
.claude/settings.local.json

# Review bundles. Regenerable git output, named olympus-<unit>-review.txt by
# the review-request skill. The reviews and triages beside them are tracked
# .md files; the bundles are a cache, and an untracked few hundred kilobytes
# under docs/reviews/ is one `git add docs/reviews/` from being committed.
docs/reviews/*.txt

# Exception, by maintainer request: a bundle the maintainer needs to reach
# from a device that is not the machine that generated it. Named per unit and
# negated one file at a time, deliberately — a blanket negation would restore
# exactly the accident the rule above exists to prevent. The tracked copy is
# still a cache: the SHA-256 in the companion review-request file, with the
# base and head commits, is what makes a bundle verifiable, and the bundle can
# always be regenerated from those.
!docs/reviews/2026-09-11-P3-policy-engine-review-bundle.txt
